{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/auth/(.*)", "destination": "/api/index.js" },
    { "source": "/styles.css", "destination": "/frontend/styles.css" },
    { "source": "/app.js", "destination": "/frontend/app.js" },
    { "source": "/standalone-engine.js", "destination": "/frontend/standalone-engine.js" },
    { "source": "/sw.js", "destination": "/frontend/sw.js" },
    { "source": "/manifest.json", "destination": "/frontend/manifest.json" },
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/index.html", "destination": "/frontend/index.html" }
  ]
}
